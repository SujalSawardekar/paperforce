# ─── Paperforce India LLP — Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/paperforce
# Neon:    postgresql://user:pass@ep-xxx.neon.tech/paperforce?sslmode=require
# Supabase: postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/paperforce

# ── NextAuth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-a-real-secret
NEXTAUTH_URL=http://localhost:3000

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get API key at https://resend.com — free tier: 3,000 emails/month
# If left empty, emails are logged to console (dev fallback)
RESEND_API_KEY=

# Email address that receives new RFQ notifications
SALES_EMAIL=info@paperforce.in

# The "from" address for outbound emails (must be verified in Resend)
EMAIL_FROM=Paperforce India <noreply@paperforce.in>

# ── Cloudinary (Product Image CDN) ────────────────────────────────────────────
# Get credentials at https://cloudinary.com — free tier: 25GB
# If left empty, images are stored in /public/uploads (dev fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── ISR Revalidation ───────────────────────────────────────────────────────────
# Secret token for the /api/revalidate webhook endpoint
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=change-me-generate-a-real-secret

# ── Admin Seed ─────────────────────────────────────────────────────────────────
# Credentials for the default seeded admin user
# Change immediately after first login
SEED_ADMIN_EMAIL=admin@paperforce.in
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
